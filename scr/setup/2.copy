#!/usr/bin/env bash
# shellcheck disable=SC2034
####################################################################
# 2.copy
####################################################################
# Author:       Ragdata
# Date:         06/05/2026
# License:      MIT License
# Repository:	https://github.com/Ragdata/.dotfiles
# Copyright:    Copyright © 2026 Redeyed Technologies
####################################################################
# PRE-FLIGHT
####################################################################
# set -x
BASEDIR="$(cd -P "$(dirname "$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")")")" >/dev/null 2>&1 && pwd)"

source ./.functions

####################################################################
# VARIABLES
####################################################################

####################################################################
# PROCESS
####################################################################
print::head "Installing Files ..."
for dir in "$BASEDIR"/sys/lib/*; do
    if [ -d "$dir" ]; then
        print::default "Install files in $HOME/.labware/lib${dir#"${dir%/*}"}"
        install::files "$dir" "$HOME"/.labware/lib"${dir#"${dir%/*}"}"
    fi
done

print::head "Backing Up Dotfiles ..."
[ ! -d "$HOME"/.backup ] && mkdir -p "$HOME"/.backup
if ! install -m 644 "$HOME"/.bashrc "$HOME"/.backup/.bashrc."$(date +%Y%m%d)"; then
    print::warn "Failed to backup '$HOME/.bashrc'"
fi
if ! install -m 644 "$HOME"/.profile "$HOME"/.backup/.profile."$(date +%Y%m%d)"; then
    print::warn "Failed to backup '$HOME/.profile'"
fi

print::head "Installing Dotfiles ..."
for item in "$BASEDIR"/sys/dots/*; do
    if [ -d "$item" ]; then
        install::files "$item" "$HOME${item#"${item%/*}"}"
    elif [ -f "$item" ]; then
        if install -m 644 "$item" "$HOME/$(basename "$item")"; then
            print::success "Installed '$HOME/$(basename "$item")'"
        else
            print::warn "Failed to install '$HOME/$(basename "$item")'"
        fi
    fi
done

print::head "Installing Configs ..."
for item in "$BASEDIR"/sys/etc/*; do
   if [ -d "$item" ]; then
       install::files "$item" "$HOME/.labware/etc${item#"${item%/*}"}"
   fi
done
